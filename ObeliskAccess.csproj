<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>ObeliskAccess</AssemblyName>
    <Product>ObeliskAccess</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>ObeliskAccess</RootNamespace>
    <!-- Overridable: dotnet build -p:GameDir=... for a non-default install location. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk</GameDir>
    <GameManagedDir>$(GameDir)\AcrossTheObelisk_Data\Managed</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <!-- Screen-reader speech (UniversalSpeech + SAPI fallback). net46 resolves the package's net35
         build, which loads fine under BepInEx 5's Mono runtime. -->
    <PackageReference Include="UnityAccessibilityLib" Version="2.0.0" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(GameManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Game's own UnityEngine.dll is a type-forwarder shim (not the old monolithic build) -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- NetworkManager derives from Photon's MonoBehaviourPunCallbacks, so any code touching it
         needs the game's Photon assembly on the compile path. -->
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Photon.Realtime.Player appears in the PUN callback signatures the mod patches
         (OnPlayerEnteredRoom/OnPlayerLeftRoom/OnMasterClientSwitched). -->
    <Reference Include="PhotonRealtime">
      <HintPath>$(GameManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Both copy targets are skipped with -p:SkipDeploy=true. GameDir is the SOURCE of every game
       DLL reference above as well as the copy destination, so a build that must not touch the
       install (the release build) has to opt out of the copies here - it cannot redirect GameDir,
       which would also point the HintPaths at a folder with no game DLLs in it. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <!-- The mod, plus its speech dependency, which BepInEx must find next to the plugin. -->
      <PluginFiles Include="$(OutputPath)$(AssemblyName).dll" />
      <PluginFiles Include="$(OutputPath)UnityAccessibilityLib.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(PluginFiles)"
      DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)"
    />
  </Target>

  <!-- UniversalSpeech is a native lib; its DLLs must sit next to the game executable (P/Invoke
       resolves native DLLs from the exe's directory, not the plugin folder). Copy the committed
       copies from native/ into the game root, but ONLY when absent, so a user's own/newer copy or a
       different-arch build they placed is never overwritten. Guarded on the source existing so the
       build doesn't fail before the binaries have been added to native/. -->
  <Target Name="CopyNativeSpeech" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\native\UniversalSpeech.dll"
      DestinationFolder="$(GameDir)"
      Condition="Exists('$(MSBuildProjectDirectory)\native\UniversalSpeech.dll') And !Exists('$(GameDir)\UniversalSpeech.dll')"
    />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\native\nvdaControllerClient.dll"
      DestinationFolder="$(GameDir)"
      Condition="Exists('$(MSBuildProjectDirectory)\native\nvdaControllerClient.dll') And !Exists('$(GameDir)\nvdaControllerClient.dll')"
    />
  </Target>

</Project>
