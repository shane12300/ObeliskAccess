<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>ObeliskAccess</AssemblyName>
    <Product>My first plugin</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>ObeliskAccess</RootNamespace>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <!-- Screen-reader speech (UniversalSpeech + SAPI fallback). net46 resolves the package's net35
         build, which loads fine under BepInEx 5's Mono runtime. -->
    <PackageReference Include="UnityAccessibilityLib" Version="2.0.0" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk\AcrossTheObelisk_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk\AcrossTheObelisk_Data\Managed\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Game's own UnityEngine.dll is a type-forwarder shim (not the old monolithic build) -->
    <Reference Include="UnityEngine">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk\AcrossTheObelisk_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk\AcrossTheObelisk_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk\AcrossTheObelisk_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk\AcrossTheObelisk_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk\AcrossTheObelisk_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\common\Across the Obelisk\AcrossTheObelisk_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <ItemGroup>
      <!-- The mod, plus its speech dependency, which BepInEx must find next to the plugin. -->
      <PluginFiles Include="$(OutputPath)$(AssemblyName).dll" />
      <PluginFiles Include="$(OutputPath)UnityAccessibilityLib.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(PluginFiles)"
      DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)"
    />
  </Target>

  <!-- UniversalSpeech is a native lib; its DLLs must sit next to the game executable (P/Invoke
       resolves native DLLs from the exe's directory, not the plugin folder). Copy the committed
       copies from native/ into the game root, but ONLY when absent, so a user's own/newer copy or a
       different-arch build they placed is never overwritten. Guarded on the source existing so the
       build doesn't fail before the binaries have been added to native/. -->
  <Target Name="CopyNativeSpeech" AfterTargets="Build">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\native\UniversalSpeech.dll"
      DestinationFolder="$(GameDir)"
      Condition="Exists('$(MSBuildProjectDirectory)\native\UniversalSpeech.dll') And !Exists('$(GameDir)\UniversalSpeech.dll')"
    />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\native\nvdaControllerClient.dll"
      DestinationFolder="$(GameDir)"
      Condition="Exists('$(MSBuildProjectDirectory)\native\nvdaControllerClient.dll') And !Exists('$(GameDir)\nvdaControllerClient.dll')"
    />
  </Target>

</Project>
